 * Jeśli kiedyś odkomentujesz checkbox #addon-checkbox, cena zacznie doliczać addonPrice,
 * a przycisk automatycznie przełączy link z soloUrl na bundleUrl.
 */
const productPrice = 1029;
const addonPrice = 50;

const tableVariants = {
  g1: {
    shippingPrice: 0,
    shippingText: 'gratis',
    soloUrl: 'https://cart.easy.tools/checkout/patryktrajder/wykrawarka-do-rur-i-profili-tube-notcher-otwornica-tn01-4?lang=pl',
    bundleUrl: 'https://cart.easy.tools/checkout/patryktrajder/wykrawarka-do-rur-i-profili-tube-notcher-otwornica-tn01-adapter?lang=pl'
  },
  g2: {
    shippingPrice: 49,
    shippingText: '49 zł',
    soloUrl: 'https://cart.easy.tools/checkout/patryktrajder/wykrawarka-do-rur-i-profili-tube-notcher-otwornica-tn01-2?lang=pl',
    bundleUrl: ''
  },
  g3: {
    shippingPrice: 139,
    shippingText: '139 zł',
    soloUrl: 'https://cart.easy.tools/checkout/patryktrajder/wykrawarka-do-rur-i-profili-tube-notcher-otwornica-tn01-3?lang=pl',
    bundleUrl: ''
  }
};

function formatPrice(value) {
  return value.toLocaleString('pl-PL', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  }) + ' zł';
}

/**
 * Aktualizacja ceny i linku Easytools po wyborze kraju dostawy
 * oraz po zaznaczeniu przyszłego checkboxa z pakietem.
 */
function updateTableLink() {
  const selectBox = document.getElementById('table-config');
  const addonCheckbox = document.getElementById('addon-checkbox');
  const buyBtn = document.getElementById('buy-table-btn');
  const label = document.getElementById('config-label');
  const summaryProductPrice = document.getElementById('summary-product-price');
  const summaryAddonRow = document.getElementById('summary-addon-row');
  const summaryAddonPrice = document.getElementById('summary-addon-price');
  const summaryShippingPrice = document.getElementById('summary-shipping-price');
  const summaryShippingLabel = document.getElementById('summary-shipping-label');
  const summaryTotalPrice = document.getElementById('summary-total-price');

  if (!selectBox || !buyBtn || !label) return;

  const selectedVariant = tableVariants[selectBox.value];
  const isAddon = addonCheckbox ? addonCheckbox.checked : false;

  if (!selectedVariant) {
    buyBtn.href = 'javascript:void(0)';
    return;
  }

  const finalPrice = productPrice + selectedVariant.shippingPrice + (isAddon ? addonPrice : 0);
  const finalUrl = isAddon ? selectedVariant.bundleUrl : selectedVariant.soloUrl;

  if (summaryProductPrice) {
    summaryProductPrice.innerText = formatPrice(productPrice);
  }

  if (summaryAddonRow) {
    summaryAddonRow.style.display = isAddon ? 'flex' : 'none';
  }

  if (summaryAddonPrice) {
    summaryAddonPrice.innerText = formatPrice(addonPrice);
  }

  if (summaryShippingPrice) {
    summaryShippingPrice.innerText = formatPrice(selectedVariant.shippingPrice);
  }

  if (summaryShippingLabel) {
    summaryShippingLabel.style.display = selectedVariant.shippingPrice === 0 ? 'inline' : 'none';
  }

  if (summaryTotalPrice) {
    summaryTotalPrice.innerText = formatPrice(finalPrice);
  }

  // Jeśli nie wpiszesz jeszcze linku Easytools dla wybranego wariantu,
  // przycisk zostanie zablokowany zamiast prowadzić do złego produktu.
  buyBtn.href = finalUrl || 'javascript:void(0)';

  label.style.color = '#707070';
  label.style.fontWeight = '400';
  label.innerHTML = 'Wybierz kraj dostawy';

  selectBox.style.borderColor = '#c5c4c4';
  selectBox.style.boxShadow = 'none';

  // DROPDOWN KRAJU DOSTAWY - zdejmij błąd z nowego dropdowna po poprawnym wyborze
  const customSelect = document.getElementById('custom-country-select');
  if (customSelect) {
    customSelect.classList.remove('is-error');
  }
}

/**
 * Obsługa kliknięcia w przycisk, gdy klient nie wybrał kraju dostawy
 * albo gdy w przyszłości zaznaczony będzie pakiet bez uzupełnionego linku Easytools.
 */
function handleTableDisabledClick() {
  const selectBox = document.getElementById('table-config');
  const addonCheckbox = document.getElementById('addon-checkbox');
  const label = document.getElementById('config-label');

  if (!selectBox || !label) return true;

  const selectedVariant = tableVariants[selectBox.value];
  const isAddon = addonCheckbox ? addonCheckbox.checked : false;

  if (!selectedVariant) {
    label.style.color = 'red';
    label.style.fontWeight = 'bold';
    label.innerHTML = 'Wybierz kraj dostawy:';

    selectBox.style.borderColor = 'red';
    selectBox.style.boxShadow = '0 0 5px rgba(255, 0, 0, 0.4)';

    // DROPDOWN KRAJU DOSTAWY - pokaż błąd na nowym dropdownie zamiast na ukrytym select
    const customSelect = document.getElementById('custom-country-select');
    const customInput = document.getElementById('custom-country-input');

    if (customSelect && customInput) {
      customSelect.classList.add('is-error');
      customInput.focus({ preventScroll: true });
      customSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });

      setTimeout(() => customInput.focus(), 500);
    } else {
      selectBox.focus({ preventScroll: true });
      selectBox.scrollIntoView({ behavior: 'smooth', block: 'center' });

      setTimeout(() => selectBox.focus(), 500);
    }

    return false;
  }

  const finalUrl = isAddon ? selectedVariant.bundleUrl : selectedVariant.soloUrl;

  if (!finalUrl) {
    label.style.color = 'red';
    label.style.fontWeight = 'bold';
    label.innerHTML = isAddon
      ? 'Brakuje linku Easytools dla wybranego zestawu.'
      : 'Brakuje linku Easytools dla wybranego kraju dostawy.';
    return false;
  }

  return true;
}

/**
 * DROPDOWN KRAJU DOSTAWY
 * Nowy ładny dropdown ustawia wartość w ukrytym select #table-config.
 * Dzięki temu obecna logika ceny i linków Easytools nadal działa przez updateTableLink().
 */
function initCustomCountrySelect() {
  const nativeSelect = document.getElementById('table-config');
  const customSelect = document.getElementById('custom-country-select');
  const input = document.getElementById('custom-country-input');
  const dropdown = document.getElementById('custom-country-dropdown');
  const arrow = customSelect ? customSelect.querySelector('.custom-country-select__arrow') : null;

  if (!nativeSelect || !customSelect || !input || !dropdown) return;

  const nativeOptions = Array.from(nativeSelect.options);

  const options = nativeOptions
    .filter(function(option) {
      return !option.disabled && option.value !== 'none';
    })
    .map(function(option, index) {
      return {
        value: option.value,
        text: option.textContent.trim(),
        nativeIndex: nativeOptions.indexOf(option),
        id: index
      };
    });

  let selectedOption = options.find(function(option) {
    return nativeSelect.options[option.nativeIndex].selected;
  }) || options[0];

  function setSelected(option) {
    selectedOption = option;

    nativeSelect.selectedIndex = option.nativeIndex;
    input.value = option.text;

    customSelect.classList.remove('is-open');
    customSelect.classList.remove('is-error');

    renderOptions(input.value);
    updateTableLink();
  }

  function renderOptions(searchText) {
    const query = searchText.toLowerCase().trim();

    const filteredOptions = options.filter(function(option) {
      return option.text.toLowerCase().includes(query);
    });

    dropdown.innerHTML = '';

    if (!filteredOptions.length) {
      const empty = document.createElement('div');
      empty.className = 'custom-country-select__empty';
      empty.textContent = 'Brak wyników';
      dropdown.appendChild(empty);
      return;
    }

    filteredOptions.forEach(function(option) {
      const optionEl = document.createElement('div');
      optionEl.className = 'custom-country-select__option';
      optionEl.textContent = option.text;

      if (selectedOption && option.nativeIndex === selectedOption.nativeIndex) {
        optionEl.classList.add('is-selected');
      }

      optionEl.addEventListener('mousedown', function(event) {
        event.preventDefault();
        setSelected(option);
      });

      dropdown.appendChild(optionEl);
    });
  }

  function openDropdown() {
    customSelect.classList.add('is-open');
    customSelect.classList.remove('is-error');
    input.focus();
    input.select();
    renderOptions('');
  }

  function closeDropdown() {
    customSelect.classList.remove('is-open');

    if (selectedOption) {
      input.value = selectedOption.text;
    }
  }

  input.value = selectedOption.text;
  renderOptions('');

  input.addEventListener('focus', function() {
    openDropdown();
  });

 if (arrow) {
  arrow.addEventListener('mousedown', function(event) {
    event.preventDefault();
    event.stopPropagation();

    if (customSelect.classList.contains('is-open')) {
      closeDropdown();
      input.blur();
    } else {
      openDropdown();
    }
  });
}

  input.addEventListener('input', function() {
    customSelect.classList.add('is-open');
    customSelect.classList.remove('is-error');
    renderOptions(input.value);
  });

  input.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      closeDropdown();
      input.blur();
    }
  });

  document.addEventListener('click', function(event) {
    if (!customSelect.contains(event.target)) {
      closeDropdown();
    }
  });
}

/**
 * Kopiowanie adresu e-mail
 */
function copyEmail(element) {
  navigator.clipboard.writeText('sklep@trajder.com').then(function() {
    const numberSpan = element.querySelector('.number');
    numberSpan.innerHTML = '<span style="color: #00a650;">Skopiowano! ✓</span>';

    setTimeout(function() {
      numberSpan.innerHTML = 'sklep@trajder.com';
    }, 2000);
  });
}

document.addEventListener('DOMContentLoaded', function() {
  initCustomCountrySelect();
  updateTableLink();
});
</script>


