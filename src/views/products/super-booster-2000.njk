<script>
/**
 * Konfiguracja wariantów dostawy + przyszłych zestawów.
 *
 * productPrice = cena samego produktu
 * shippingPrice = koszt dostawy dla wybranej grupy
 * soloUrl = link Easytools dla samego produktu
