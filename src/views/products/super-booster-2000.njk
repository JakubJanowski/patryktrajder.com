    <div class="product-details">



<style>
  .purchase-panel {
    max-width: 400px;
  }

  .purchase-panel__title {
    margin-bottom: 6px;
  }

  .purchase-panel__reviews {
    margin: 0 0 14px 0;
  }

  .price-summary-card {
    max-width: 400px;
    margin: 0 0 24px 0;
    padding: 14px 16px 16px;
    border: 1px solid #dbe5f1;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 8px 22px rgba(15, 23, 42, 0.06);
    box-sizing: border-box;
  }

  .price-summary-card__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 12px;
    color: #1f2937;
    font-size: 16px;
    line-height: 1.25;
  }

  .price-summary-card__left {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .price-summary-card__icon {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    display: inline-block;
    background: #64748b;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
  }

  .price-summary-card__icon--label {
    background: #707070;
    -webkit-mask-image: url('/assets/icons/label.png');
    mask-image: url('/assets/icons/label.png');
  }



.price-summary-card__icon--addon {
  background: #707070;
  -webkit-mask-image: url('/assets/icons/dodatek.png');
  mask-image: url('/assets/icons/dodatek.png');
}



  .price-summary-card__icon--delivery {
    background: #007bff;
    -webkit-mask-image: url('/assets/icons/delivery.svg');
    mask-image: url('/assets/icons/delivery.svg');
  }

  .price-summary-card__value {
    margin-left: auto;
    white-space: nowrap;
    font-weight: 700;
    color: #707070;
  }

  .price-summary-card__value--shipping {
    color: #008f2f;
  }

  .price-summary-card__divider {
    height: 1px;
    margin: 4px 0 13px;
    background: #d8dee8;
  }

  .price-summary-card__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    color: #007cf0;
    font-weight: 800;
    line-height: 1.2;
  }

  .price-summary-card__total-label {
    font-size: 16px;
  }

  .price-summary-card__total-value {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    margin-left: auto;
    white-space: nowrap;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .price-summary-card__tax {
    color: #707070;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .purchase-shipping-select {
    max-width: 400px;
    margin-top: 12px;
  }

  .purchase-shipping-select__label {
    margin: 0 0 16px;
    color: #707070;
    font-size: 1.18rem;
    line-height: 1.3;
  }

  .purchase-shipping-select select {
    width: 100%;
    padding: 10px;
    font-size: 16px;
    border: 1px solid #c5c4c4;
    border-radius: 4px;
    background: #fefdfa;
    color: #333;
    outline: none;
    box-sizing: border-box;
  }

  .purchase-shipping-select__note {
    margin-top: 10px;
    font-size: 0.85rem;
    color: #666;
    line-height: 1.45;
  }

  /* DROPDOWN KRAJU DOSTAWY - ukrywa stary select, ale zostawia go dla logiki Easytools */
  .purchase-shipping-select__native {
    display: none;
  }

  /* DROPDOWN KRAJU DOSTAWY - własny wygląd pola wyboru */
  .custom-country-select {
    position: relative;
    width: 100%;
    max-width: 400px;
    margin-top: 6px;
    font-size: 16px;
  }

  .custom-country-select__control {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 42px;
    border: 1px solid #c5c4c4;
    border-radius: 8px;
    background: #ffffff;
    box-sizing: border-box;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .custom-country-select.is-open .custom-country-select__control {
    border-color: #007cf0;
    box-shadow: 0 0 0 1px rgba(0, 124, 240, 0.15);
  }

  .custom-country-select.is-error .custom-country-select__control {
    border-color: red;
    box-shadow: 0 0 5px rgba(255, 0, 0, 0.4);
  }

  .custom-country-select__label {
    position: absolute;
    top: -9px;
    left: 11px;
    padding: 0 5px;
    background: #ffffff;
    color: #707070;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    pointer-events: none;
  }

  .custom-country-select.is-open .custom-country-select__label {
    color: #007cf0;
  }

  .custom-country-select.is-error .custom-country-select__label {
    color: red;
  }

  .custom-country-select__input {
    width: 100%;
    height: 40px;
    padding: 10px 42px 10px 12px;
    border: 0;
    background: transparent;
    color: #111827;
    font-size: 16px;
    outline: none;
    box-sizing: border-box;
  }

.custom-country-select__arrow {
  position: absolute;
  right: 12px;
  width: 10px;
  height: 10px;
  border-right: 2px solid #707070;
  border-bottom: 2px solid #707070;
  transform: rotate(45deg);
  transition: transform 0.18s ease;
  cursor: pointer;
  pointer-events: auto;
  z-index: 2;
}

  .custom-country-select.is-open .custom-country-select__arrow {
    transform: rotate(225deg);
    margin-top: 6px;
  }

  .custom-country-select__dropdown {
    position: absolute;
    z-index: 30;
    top: calc(100% + 2px);
    left: 0;
    right: 0;
    max-height: 260px;
    overflow-y: auto;
    border: 1px solid #c5c4c4;
    border-radius: 0 0 8px 8px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.12);
    display: none;
  }

  .custom-country-select.is-open .custom-country-select__dropdown {
    display: block;
  }

  .custom-country-select__option {
    padding: 8px 12px;
    border-bottom: 1px solid #e5e7eb;
    color: #111827;
    font-size: 15px;
    line-height: 1.35;
    cursor: pointer;
    user-select: none;
  }

  .custom-country-select__option:hover,
  .custom-country-select__option.is-highlighted {
    background: #eef6ff;
  }

  .custom-country-select__option.is-selected {
    color: #007cf0;
    font-weight: 700;
  }

  .custom-country-select__empty {
    padding: 10px 12px;
    color: #707070;
    font-size: 14px;
  }

  .buy-box {
    max-width: 400px;
    margin-top: 24px;
    margin-bottom: 12px;
  }

  .buy-box__button {
    width: 100%;
    min-height: 54px;
    margin: 0;
    padding: 0 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    box-sizing: border-box;
  }

  .purchase-panel .checkout-note {
    max-width: 400px;
    margin-top: 0;
    text-align: center;
  }

  .purchase-panel .payment-icons {
    max-width: 400px;
    text-align: center;
    margin-top: 24px;
    opacity: 0.85;
  }

  .availability-item__shipping-logos {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: 8px;
    vertical-align: middle;
  }

  .availability-item__shipping-logo {
    display: block;
    width: auto;
    object-fit: contain;
  }

  .availability-item__shipping-logo--inpost {
    height: 46px;
  }

  .availability-item__shipping-logo--dpd {
    height: 20px;
  }

.product-availability-list {
  max-width: 400px;
  margin-top: 12px;
  border-top: 1px solid #e5e7eb;
}

.product-availability-list .availability {
  margin: 0;
  padding: 0;
  border: 0;
}

.product-availability-list .availability + .availability {
  border-top: 1px solid #e5e7eb;
}

.product-availability-list .availability p {
  margin: 0;
}

.product-availability-list .availability-item {
  width: 100%;
  padding: 2px 0;
  border: 0;
  line-height: 1.35;
}

.product-availability-list .availability-item--link {
  border: 0;
}

  @media (max-width: 768px) {
    .price-summary-card,
    .purchase-shipping-select,
    .buy-box,
    .purchase-panel .checkout-note,
    .purchase-panel .payment-icons,
    .product-availability-list {
      max-width: 100%;
    }

    .price-summary-card__total {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }

    .price-summary-card__total-value {
      margin-left: 0;
      font-size: 24px;
    }
  }


.addon-card {
  margin: 18px 0 12px;
}
</style>

