/** OPINIE - zdjecia w opiniach  */
document.addEventListener('DOMContentLoaded', function () {
  const reviewsSection = document.querySelector('.product-reviews-section');
  if (!reviewsSection) return;

  const lightbox = reviewsSection.querySelector('#product-review-lightbox');
  const lightboxImage = reviewsSection.querySelector('#product-review-lightbox-image');

  if (!lightbox || !lightboxImage) return;

  reviewsSection.querySelectorAll('.product-opinion-gallery__item').forEach((button) => {
    button.addEventListener('click', function () {
      const fullImage = this.getAttribute('data-full');
      if (!fullImage) return;

      lightboxImage.src = fullImage;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  lightbox.querySelectorAll('[data-close-review-lightbox]').forEach((element) => {
    element.addEventListener('click', function () {
      lightbox.hidden = true;
      lightboxImage.src = '';
      document.body.style.overflow = '';
    });
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && !lightbox.hidden) {
      lightbox.hidden = true;
      lightboxImage.src = '';
      document.body.style.overflow = '';
    }
  });
});
