<script>
/**
 * 1. GŁÓWNA FUNKCJA: Logika wyboru stołu, aktualizacja ceny i linku EasyCart
 */
function updateTableLink() {
  const config = document.getElementById('table-config').value;
  const addonCheckbox = document.getElementById('addon-checkbox');
  const isAddon = addonCheckbox.checked;
  const buyBtn = document.getElementById('buy-table-btn');
  const label = document.getElementById('config-label');
  const priceDisplay = document.getElementById('main-price-value');

  // --- AKTUALIZACJA CENY NA STRONIE ---
  // Pozwalamy klientowi klikać checkbox w dowolnym momencie
  let basePrice = 129;
  let finalPrice = isAddon ? (basePrice + 49) : basePrice;
  
  if (priceDisplay) {
    priceDisplay.innerText = finalPrice;
  }

  // --- DEFINICJA LINKÓW EASYCART ---
  const soloLinks = {
    's28_15': 'https://cart.easy.tools/checkout/patryktrajder/plany-budowy-stolu-spawalniczego-2000x1000-system-o28-2?lang=pl',
    
    
  };

  const bundleLinks = {
    's28_15': 'https://cart.easy.tools/checkout/patryktrajder/plany-budowy-stolu-spawalniczego-2000x1000-system-o28-8?lang=pl',
    
  };

  // --- LOGIKA PRZYCISKU (Tu jest blokada zakupu) ---
  if (config !== "none") {
    // Jeśli stół jest wybrany: odblokuj przycisk i przypisz odpowiedni link
    buyBtn.href = isAddon ? bundleLinks[config] : soloLinks[config];
    buyBtn.classList.remove('disabled-btn');
    
    // Zdejmij ewentualne czerwone ostrzeżenie
    label.style.color = '#707070';
    label.style.fontWeight = '400';
    label.innerHTML = 'Wybierz konfigurację planów:';

    // Zgaś czerwoną ramkę
    const selectBox = document.getElementById('table-config');
    selectBox.style.borderColor = '#c5c4c4';
    selectBox.style.boxShadow = 'none';
  } else {
    // Jeśli stół NIE jest wybrany: przycisk zablokowany (nawet jeśli dodatek jest zaznaczony)
    buyBtn.href = 'javascript:void(0)';
    buyBtn.classList.add('disabled-btn');
  }
}

/**
 * 2. FUNKCJA: Obsługa kliknięcia w zablokowany przycisk
 */
function handleTableDisabledClick() {
  const config = document.getElementById('table-config').value; // Teraz sprawdzamy wybór, a nie klasę
  const label = document.getElementById('config-label');
  const selectBox = document.getElementById('table-config');
  
  if (config === "none") {
    label.style.color = 'red';
    label.style.fontWeight = 'bold';
    label.innerHTML = 'Wybierz konfigurację planów:';
    
    selectBox.style.borderColor = 'red';
    selectBox.style.boxShadow = '0 0 5px rgba(255, 0, 0, 0.4)';
    selectBox.focus({ preventScroll: true });
    selectBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    // Opcjonalnie zostawiamy focus, żeby po przewinięciu lista była "aktywna"
    setTimeout(() => selectBox.focus(), 500);
  }
}

/**
 * 3. TWOJA FUNKCJA: Kopiowanie adresu e-mail
 */
function copyEmail(element) {
  navigator.clipboard.writeText('sklep@trajder.com').then(function() {
    const numberSpan = element.querySelector('.number');
    numberSpan.innerHTML = '<span style="color: #00a650;">Skopiowano! ✓</span>';
    
    setTimeout(function() {
      numberSpan.innerHTML = 'sklep@trajder.com';
    }, 2000);
  });
}
</script>


