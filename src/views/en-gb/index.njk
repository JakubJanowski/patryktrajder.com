    <script>
// opinie, zdjecie aby mozna bylo klikac
document.addEventListener('DOMContentLoaded', function () {
  const reviewsSection = document.querySelector('.homepage-reviews');
  if (!reviewsSection) return;

  const lightbox = reviewsSection.querySelector('#product-review-lightbox');
  const lightboxImage = reviewsSection.querySelector('#product-review-lightbox-image');

  if (!lightbox || !lightboxImage) return;

  reviewsSection.querySelectorAll('.product-opinion-gallery__item').forEach((button) => {
    button.addEventListener('click', function () {
      const fullImage = this.getAttribute('data-full');
      if (!fullImage) return;

      lightboxImage.src = fullImage;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  reviewsSection.querySelectorAll('[data-close-review-lightbox]').forEach((element) => {
    element.addEventListener('click', function () {
      lightbox.hidden = true;
      lightboxImage.src = '';
      document.body.style.overflow = '';
    });
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && !lightbox.hidden) {
      lightbox.hidden = true;
      lightboxImage.src = '';
      document.body.style.overflow = '';
    }
  });
});




//slider produktow
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.product-scroller').forEach((scroller) => {
    let isMouseDown = false;
    let isDragging = false;
    let startX = 0;
    let startScrollLeft = 0;
    let preventClick = false;

    scroller.addEventListener('mousedown', function (e) {
      if (e.button !== 0) return; // tylko lewy przycisk myszy

      isMouseDown = true;
      isDragging = false;
      preventClick = false;
      startX = e.pageX;
      startScrollLeft = scroller.scrollLeft;
    });

    window.addEventListener('mousemove', function (e) {
      if (!isMouseDown) return;

      const dx = e.pageX - startX;

      // dopiero po realnym ruchu zaczynamy drag
      if (!isDragging && Math.abs(dx) > 8) {
        isDragging = true;
        preventClick = true;
        scroller.classList.add('is-dragging');
      }

      if (!isDragging) return;

      scroller.scrollLeft = startScrollLeft - dx;
      e.preventDefault();
    });

    function stopDrag() {
      if (!isMouseDown) return;

      isMouseDown = false;
      scroller.classList.remove('is-dragging');

      // po prawdziwym dragowaniu blokujemy tylko najbliższy klik
      if (isDragging) {
        setTimeout(() => {
          preventClick = false;
        }, 0);
      }

      isDragging = false;
    }

    window.addEventListener('mouseup', stopDrag);
    scroller.addEventListener('mouseleave', stopDrag);

    scroller.addEventListener('click', function (e) {
      if (preventClick) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    // opcjonalnie: żeby przeglądarka nie próbowała zaznaczać tekstu przy szybkim dragowaniu
    scroller.querySelectorAll('a, img').forEach((el) => {
      el.setAttribute('draggable', 'false');
    });
  });
});
//slider produktow
</script>





        </article>
    </main>
{% endblock %}