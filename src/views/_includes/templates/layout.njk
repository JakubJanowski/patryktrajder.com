                        <p>
                            <a href="mailto:patryk@trajder.com" rel="nofollow noopener" target="_blank" title="patryk@trajder.com">patryk@trajder.com</a>
                        </p>
                        <p class="phone">
                            <svg class="icon">
                                <use xlink:href="#icon-mobile"></use>
                            </svg>
                            <a href="tel:+48602106170" rel="nofollow noopener" target="_blank">602 106 170</a>
                        </p>
                    </div>
                    <div>
                        <h3>Regulaminy:</h3>
                        <p>
                            <a href="/privacy-policy.pdf" target="_blank">Polityka prywatności</a>
                        </p>
                        <p>
                            <a href="/terms-of-service.pdf" target="_blank">Regulamin</a>
                        </p>
                    </div>
                </div>
            </section>
            <div class="copyright">
                <div>
                    <ul class="separated-list">
                        <li>&copy; Patryk Trajder. All rights reserved.</li>
                        <li>
                            Design & development:&#32;
                            <a href="https://jakubjanowski.com/pl/" rel="noopener" target="_blank" title="Potrzebujesz strony internetowej?">Jakub Janowski</a>
                        </li>
                    </ul>
                </div>
            </div>
        </footer>

     





<style>
  #cookies-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.18);
    opacity: 1;
    transition: opacity 0.3s ease;
    z-index: 9998;
    pointer-events: none;
  }

  #cookies-backdrop.cookies-backdrop-hidden {
    opacity: 0;
  }

  #cookies-notice {
    position: fixed;
    left: 32px;
    bottom: 32px;
    max-width: 430px;
    width: calc(100vw - 64px);
    padding: 24px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    opacity: 1;
    transform: translateY(0) scale(1);
    transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), opacity 0.3s ease;
    z-index: 9999;
    box-sizing: border-box;
  }

  #cookies-notice.cookies-hidden {
    transform: translateY(100%) scale(0.9);
    opacity: 0;
    pointer-events: none;
  }

  #cookies-notice .heading {
    color: #0b74e5;
    font-size: 32px;
    line-height: 1.05;
    font-weight: 700;
    margin-bottom: 12px;
  }

  #cookies-notice p {
    margin: 0 0 18px;
    line-height: 1.5;
  }

  #cookies-notice .cookies-actions {
    display: flex;
    gap: 12px;
    margin: 0;
  }

  #cookies-notice .cookies-actions button {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
  }

  @media (min-width: 601px) {
    #cookies-backdrop {
      background: transparent;
    }
  }

  @media (max-width: 600px) {
    #cookies-notice {
      left: 10px;
      right: 10px;
      bottom: 10px;
      width: auto;
      max-width: none;
      padding: 20px;
    }

    #cookies-notice .heading {
      font-size: 28px;
    }

    #cookies-notice .cookies-actions {
      flex-direction: column-reverse;
      gap: 10px;
      margin: 0;
    }

    #cookies-notice .cookies-actions button {
      display: block;
      width: 100%;
      margin: 0;
    }
  }
</style>

<template id="cookies-notice-template">
  <div id="cookies-backdrop" class="cookies-backdrop-hidden"></div>

  <div id="cookies-notice" class="cookies-hidden">
    <div class="heading">Szanujemy Twoją prywatność</div>
    <p>
      Strona internetowa używa plików cookies (tzw. ciasteczka) w celach statystycznych,
      reklamowych oraz funkcjonalnych zgodnie z
      <a href="/privacy-policy.pdf" target="_blank" rel="noopener">Polityką prywatności</a>.
      Dzięki nim możemy indywidualnie dostosować stronę do Twoich potrzeb. Każdy może
      zaakceptować pliki cookies albo ma możliwość wyłączenia ich w przeglądarce, dzięki
      czemu nie będą zbierane żadne informacje. Dowiedz się więcej jak je wyłączyć klikając
      <a href="/privacy-policy.pdf#how-to-disable-cookies" title="Jak wyłączyć ciasteczka" target="_blank" rel="noopener">tutaj</a>.
    </p>
    <div class="cookies-actions">
      <button class="reject secondary" type="button">Nie akceptuję</button>
      <button class="accept primary" type="button">Akceptuję</button>
    </div>
  </div>
</template>




