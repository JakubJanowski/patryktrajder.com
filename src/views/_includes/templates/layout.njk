                        <sup style="color: #0056b3; font-size: 16px; position: relative; top: -20px; margin-left: 3px; font-weight: 700;">&copy;</sup>
                    </a>
                </h1>

                <h1 class="second-logo" style="margin: 0; line-height: 1;">
                    <a href="/" title="Startseite" style="text-decoration: none; font-family: 'Arial Black', Gadget, sans-serif; font-weight: 900; text-transform: uppercase; display: inline-flex; align-items: baseline;">
