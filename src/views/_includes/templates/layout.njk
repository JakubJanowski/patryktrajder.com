<!DOCTYPE html>
<html lang="pl">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="theme-color" content="#007cf0">
        {% block meta %}{% endblock %}
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="/src/main.css"/>
        <link rel="manifest" href="/manifest_pl.json">
        <script defer="defer" src="/src/main.js"></script>
        {% block head %}{% endblock %}

        <script defer="defer" src="https://www.googletagmanager.com/gtag/js?id=G-ZYTND6L39E"></script>
    </head>
    <body>
        <svg aria-hidden="true" style="position: absolute; width: 0; height: 0; overflow: hidden;">
            <defs>
                {% include "vectors/arrow-drop-down.sym" %}
                {% include "vectors/arrow-drop-up.sym" %}
                {% include "vectors/facebook.sym" %}
