{% extends "templates/layout.njk" %}
{% set tab = "home" %}

{% block meta %}
  <link rel="canonical" href="https://patryktrajder.com/"/>
  <title>Patryk Trajder</title>
{% endblock meta %}

{% block vectors %}
  {% include "vectors/arrow-left.sym" %}
  {% include "vectors/arrow-right.sym" %}
{% endblock %}

{% block body %}

<div class="banner sliding-banner">
  <div class="container slider">
    <div class="wrapper">
      <div class="items">
        
        <div class="parallax-section" 
             style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url('/assets/images/banner1-h730.jpg'); 
                    height: 550px; 
                    width: 100vw; 
                    background-position: 90% center;">
          <div class="parallax-content" style="--h2-pc: 70px; --p-pc: 28px; --h2-mob: 35px; --p-mob: 18px;">
            <h2>TRAJDER<sup>&copy;</sup></h2>
            <p>Stół, który trzyma kąty za Ciebie</p>
          </div>
        </div>

        <div class="parallax-section" 
             style="background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url('/assets/images/super-booster-2000/thumb-w1120.jpg'); 
                    height: 550px; 
                    width: 100vw; 
                    background-position: 50% center;">
          <div class="parallax-content" style="--h2-pc: 70px; --p-pc: 28px; --h2-mob: 35px; --p-mob: 22px;">
            <h2>PIRANHA NOTCHER</h2>
            <p>Precyzyjne wycięcia w rurach w kilka sekund</p>
          </div>
        </div>

      </div>
    </div>

    <ul></ul>
    <button class="arrow left" aria-label="Previous slide">
      <svg class="icon"><use xlink:href="#icon-arrow-left"></use></svg>
    </button>
    <button class="arrow right" aria-label="Next slide">
      <svg class="icon"><use xlink:href="#icon-arrow-right"></use></svg>
    </button>
  </div>
</div>
